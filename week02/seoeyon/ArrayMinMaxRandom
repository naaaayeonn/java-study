import java.util.Scanner;

public class ArrayMinMaxRandom {
    public static void main(String[] args) {

        //필요한 변수 선언
        int[] num = new int[10];

        //배열 랜덤 초기화(1~100)
        for(int i=0; i<10; i++){
            int random = (int)(Math.random()*100)+1;
            num[i] = random;
        }
        //최댓값과 최솟값 초기화
        int min=num[0];
        int max=num[0];

        //배열 탐색 / 최댓값, 최솟값 저장
        for(int j=0; j<10; j++){
            if(num[j]<min)
                min = num[j];
            if(num[j]>max)
                max = num[j];
        }
        //배열 값 출력
        System.out.print("배열 값: ");
        for(int k=0; k<10; k++){
            System.out.print(num[k]);
            System.out.print(" ");
        }
        //결과 출력
        System.out.printf("\n배열의 최댓값: %d\n", max);
        System.out.printf("배열의 최솟값: %d\n", min);
    }
}
