public class ProductTest2 {
    static int totalcount = 0;
    static int bookcount = 0;
    static int eleccount = 0;
    static double totalprice;
    static double avgpices;

    public static void CalculateStatistics(Product[] products){
        totalcount = products.length;
        for(int j=0; j< products.length; j++){
            totalprice += products[j].price;
            if(products[j] instanceof CSBook){
                bookcount += 1;
            }
            else if(products[j] instanceof Electronics){
                eleccount += 1;
            }
        }
        avgpices = totalprice / totalcount;
    }
    public static void main(String[] args){
        Product[] products = new Product[6];

        products[0] = new CSBook("자바 프로그래밍", 25000, "이순신", "코딩출판사");
        products[1] = new CSBook("데이터베이스 개론", 30000, "김유신", "IT출판사");
        products[2] = new Electronics("노트북", 1200000, "삼성", 24);
        products[3] = new Electronics("스마트폰", 900000, "애플", 12);
        products[4] = new CSBook("알고리즘 문제해결", 28000, "강감찬", "AlgorithmBooks");
        products[5] = new Electronics("TV", 1500000, "LG", 36);


        System.out.println("===== 쇼핑몰 상품 목록 =====");
        for(int i=0; i<products.length; i++){
            System.out.println(products[i]);
        }

        System.out.println("\n===== 통계 정보 =====");
        CalculateStatistics(products);

        System.out.println("전체 상품 수: "+totalcount);
        System.out.println("도서 개수: "+bookcount);
        System.out.println("전자제품 수: "+eleccount);
        System.out.println("전체 삼품 총액: "+totalprice+"원");
        System.out.println("상품 평균 가격: "+avgpices+"원");
    }

}
