class Person{
    //field
    private String name;
    private String mobile;
    private String office;
    private String email;
    //constructor
    public Person(String n, String m, String o, String e){
        this.name = n;
        this.mobile = m;
        this.office = o;
        this.email = e;
    }
    public Person(String n, String m){
        this.name = n;
        this.mobile = m;
        this.office = "None";
        this.email = "None";
    }
    //method

    @Override
    public String toString() {
        return "Person [" +
                "name=" + name +
                ", mobile=" + mobile +
                ", office=" + office +
                ", email=" + email +
                "]";
    }
}

public class PersonTest{
    public static void main(String[] arg){
        Person p1 = new Person("Kim", "010-1234-5678","02-710-1234", "abc@ggg.com");
        Person p2 = new Person("Lee", "010-1111-2222", "02-1234-1234", "sss@ggg.com");
        Person p3 = new Person("Ha", "010-2222-3456");
        System.out.println(p1);
        System.out.println(p2);
        System.out.println(p3);
    }
}
