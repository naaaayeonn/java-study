import java.util.Scanner;

public class BuyerTest {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);

        System.out.print("보유 금액을 입력하세요: ");
        int money = sc.nextInt();
        Buyer buyer = new Buyer(money);

        Item[] items = {
                new Food("비빔밥", 9000),
                new Food("라면", 6000),
                new Food("김밥", 5000),
                new Book("자바야 놀자", 20000, "오라클"),
                new Movie("케이팝데몬헌터스", 15000, "매기강")
        };

        while(true){
            System.out.println("======= 상품 목록 =======");
            System.out.println("0. Food: 비빔밥(9000원)");
            System.out.println("1. Food: 라면(6000원)");
            System.out.println("2. Food: 김밥(5000원)");
            System.out.println("3. Book: 자바야 놀자 - 오라클(20000원)");
            System.out.println("4. Movie: 케이팝데몬헌터스 - 매기 강(15000원)");
            System.out.println("-1 종료");

            System.out.print("구매할 상품 번호를 입력하세요: ");
            int itemnum = sc.nextInt();
            if(itemnum == -1){
                System.out.println("프로그램을 종료합니다.");
                break;
            }
            if(itemnum <0 || itemnum >= items.length){
                System.out.println("잘못된 상품 번호입니다. 다시 입력해주세요./n");
                continue;
            }
            System.out.print("구매 개수를 입력하세요: ");
            int count = sc.nextInt();

            buyer.buy(items[itemnum], count);
            System.out.println("------------------------");
            System.out.println();

        }
    }
}
